# URL base del sitio para SEO (metadataBase, canonical, sitemap)
# En producción, configura esto como https://www.rhemapp.com
SITE_URL=http://localhost:3000

# Google Search Console: token de verificación (sin el prefijo 'google-site-verification=')
# Ej: ABCDEFG... (lo entrega Search Console)
GOOGLE_SITE_VERIFICATION=

# Medición (opcional)
# Google Analytics 4 (GA4)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=
# API.Bible se usa para abrir el pasaje completo y, cuando está disponible,
# verificar que la frase guardada pertenece literalmente al evangelio.
BIBLE_API_KEY=
# Endpoint server-side de API.Bible.
BIBLE_API_BASE_URL=https://rest.api.bible

# Supabase SSR Auth (la clave publishable sí puede llegar al navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase admin key. Never prefix with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only exact email used to provision the initial administrator. Do not commit a real value.
RHEMAPP_INITIAL_ADMIN_EMAIL=
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
LECTIO_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LECTIO_AI_ENABLED=false
LECTIO_AI_TIMEOUT_MS=20000
LECTIO_AI_MAX_TOKENS=640
LECTIO_AI_RETRY_BACKOFF_MS=250
