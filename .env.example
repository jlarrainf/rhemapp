# URL base del sitio para SEO (metadataBase, canonical, sitemap)
# En producción, configura esto como https://www.rhemapp.com
SITE_URL=http://localhost:3000

# Google Search Console: token de verificación (sin el prefijo 'google-site-verification=')
# Ej: ABCDEFG... (lo entrega Search Console)
GOOGLE_SITE_VERIFICATION=

# Medición (opcional)
# Google Analytics 4 (GA4)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=
# API.Bible se usa para abrir el pasaje completo y, cuando está disponible,
# verificar que la frase guardada pertenece literalmente al evangelio.
BIBLE_API_KEY=
